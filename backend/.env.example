# ─────────────────────────────────────────────────────
# Car Rental API — Environment Variables
# Copy this file to .env and fill in your actual values
# ─────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────
APP_NAME="Car Rental API"
APP_VERSION="1.0.0"
DEBUG=True
FRONTEND_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ── Database ─────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/car_rental_db

# ── JWT ──────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_super_secret_key_here
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth2 ─────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Brevo Email ──────────────────────────────────────
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SENDER_EMAIL=muhammadzaid51218@gmail.com
BREVO_SENDER_NAME=Velox Car Rental

# ── Resend Email ─────────────────────────────────────
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── OTP Settings ─────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
